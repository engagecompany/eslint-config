
{
  "name": "@engboxcrm/eslint-config",
  "version": "1.0.0",
  "description": "Configurações ESLint compartilhadas dos projetos Engbox.",
  "type": "module",
  "license": "MIT",
  "author": "Engbox",
  "repository": {
    "type": "git",
    "url": "https://github.com/engagecompany/eslint-config.git"
  },
  "homepage": "https://github.com/engagecompany/eslint-config#readme",
  "bugs": {
    "url": "https://github.com/engagecompany/eslint-config/issues"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.js",
    "./base": "./src/configs/base.js",
    "./typescript": "./src/configs/typescript.js",
    "./react": "./src/configs/react.js",
    "./react-native": "./src/configs/react-native.js",
    "./node": "./src/configs/node.js",
    "./prettier": "./src/prettier.js"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "peerDependencies": {
    "eslint": "^9.0.0"
  },
  "dependencies": {
    "@eslint/js": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "engbox",
    "eslint",
    "eslint-config",
    "typescript",
    "react",
    "react-native",
    "expo"
  ],
  "scripts": {
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier src --write",
    "format:check": "prettier src --check"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.0.0"
  }
}
