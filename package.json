
{
  "name": "@engboxcrm/eslint-config",
  "version": "1.1.0",
  "description": "Configurações ESLint compartilhadas dos projetos Engbox.",
  "type": "module",
  "license": "MIT",
  "author": "Engbox",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/engagecompany/eslint-config.git"
  },
  "homepage": "https://github.com/engagecompany/eslint-config#readme",
  "bugs": {
    "url": "https://github.com/engagecompany/eslint-config/issues"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./base": {
      "types": "./src/configs/base.d.ts",
      "import": "./src/configs/base.js"
    },
    "./typescript": {
      "types": "./src/configs/typescript.d.ts",
      "import": "./src/configs/typescript.js"
    },
    "./react": {
      "types": "./src/configs/react.d.ts",
      "import": "./src/configs/react.js"
    },
    "./react-native": {
      "types": "./src/configs/react-native.d.ts",
      "import": "./src/configs/react-native.js"
    },
    "./node": {
      "types": "./src/configs/node.d.ts",
      "import": "./src/configs/node.js"
    },
    "./prettier": {
      "types": "./src/prettier.d.ts",
      "import": "./src/prettier.js"
    }
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "peerDependencies": {
    "eslint": "^9.0.0"
  },
  "dependencies": {
    "@eslint/js": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "engbox",
    "eslint",
    "eslint-config",
    "typescript",
    "react",
    "react-native",
    "expo"
  ],
  "scripts": {
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier src --write",
    "format:check": "prettier src --check"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.0.0"
  }
}
